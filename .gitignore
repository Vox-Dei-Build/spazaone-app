# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Secrets / env files — never commit these.
# Match .env, .env.<anything>, and nested variants (e.g. functions/.env.local).
# Only .env.example is allowed (see negation below).
.env
.env.*
**/.env
**/.env.*
*.env
!.env.example
!**/.env.example
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Firebase / GCP service-account keys — never commit these.
pasella-ledger-430d249a5061.json
pasella-ledger-firebase-adminsdk-av7ho-985ee21a3d.json
**/*-adminsdk-*.json
**/*serviceAccount*.json
**/*service-account*.json
**/*service_account*.json
**/gcp-key*.json
**/firebase-adminsdk*.json

# Other common credential files
**/secrets/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
**/.netrc

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
# Build outputs (Flutter, Gradle, Xcode). The original `/build/` rule
# only matched the repo-root build dir. Flutter/Gradle/Xcode also
# produce build dirs at android/build/, android/app/build/, ios/build/,
# and android/app/.cxx/ for the NDK toolchain. Match all of them.
/build/
**/build/
**/.cxx/
**/DerivedData/
/functions/node_modules

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/app/release-key.keystore
/android/app/google-services.json

#ios

# FVM Version Cache
.fvm/

# Per-lane workflow scaffolding (Openclaw lanes drop these at the repo
# root for the duration of a worktree; they are local context and not
# meant to ship). Drop or rename if a future workflow needs them in-tree.
/CHAT_PROMPT.md
/LANE_CONTEXT.md
/TASK_PACKET.md
/OPENCLAW_HANDOFF_PROMPT.md
