# Uncomment this line to define a global platform for your project
platform :ios, '13.0'
use_frameworks! :linkage => :static

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Firebase iOS SDK version is intentionally NOT pinned here.
# firebase_core 3.15.2 (FlutterFire 3.x coordinated set) defaults to
# Firebase iOS 11.15.0, which is the version every firebase_*/cloud_*
# Dart plugin in pubspec.yaml was published against. Pinning to an
# older 11.x point release (11.6 / 11.8) breaks plugins that
# reference newer Firebase APIs (e.g. cloud_functions StreamResponse,
# firebase_remote_config CustomSignalValue).
#
# 11.15.0 ships gRPC-Core 1.65+ which fixes the Xcode 26 C++ template
# parse error in basic_seq.h that originally motivated the bump from
# Firebase 10.22.0.

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Required Flutter additional settings (search paths, bitcode, etc.)
    flutter_additional_ios_build_settings(target)
    # Ensure consistent minimum iOS deployment target
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Force Swift 5 for all Pods to avoid Swift 6 mode issues on Xcode 15/16
      config.build_settings['SWIFT_VERSION'] = '5.0'
      # Relax strict concurrency checks for legacy pods
      config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
      defs = Array(defs)
      defs << '$(inherited)'
      defs << 'PERMISSION_CAMERA=1'
      defs << 'PERMISSION_CONTACTS=1'
      defs << 'PERMISSION_PHOTOS=1'
      defs << 'PERMISSION_PHOTOS_ADD_ONLY=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs.uniq
      # Ensure dSYM generation for Release/Profile to include symbols in archives
      if config.name == 'Release' || config.name == 'Profile'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      else
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
      end
    end
  end

  # Temporary patch for url_launcher_ios 6.2.4 and Xcode 15+ Swift concurrency
  # Adds @MainActor @Sendable to the completion handler to match UIApplication.open
  begin
    candidates = []
    # Symlinked plugin path used by CocoaPods
    candidates += Dir.glob(File.expand_path('../.symlinks/plugins/url_launcher_ios*/ios/Classes/Launcher.swift', __dir__))
    # Pub cache path(s) that populate the symlink
    candidates += Dir.glob(File.expand_path('~/.pub-cache/hosted/pub.dev/url_launcher_ios-*/ios/Classes/Launcher.swift', __dir__))
    candidates.uniq.each do |launcher_path|
      if File.exist?(launcher_path)
        content = File.read(launcher_path)
        fixed = content.gsub(
          'completionHandler completion: ((Bool) -> Void)?',
          'completionHandler completion: (@MainActor @Sendable (Bool) -> Void)?'
        )
        fixed = fixed.gsub(
          /^protocol Launcher \{/, # only add once
          '@preconcurrency protocol Launcher {'
        )
        if content != fixed
          File.write(launcher_path, fixed)
          puts "Patched url_launcher_ios Launcher.swift at: #{launcher_path}"
        end
      end
    end
  rescue => e
    puts "Warning: failed to patch url_launcher_ios Launcher.swift: #{e}"
  end

  # Patch FirebaseStorage optional existentials under Swift 6 toolchain by force-unwrapping
  # ComponentType.instance(...) results. Idempotent and resilient to whitespace/format changes.
  begin
    storage_paths = Dir.glob(File.expand_path('../Pods/FirebaseStorage/FirebaseStorage/Sources/Storage.swift', __dir__))
    storage_paths.each do |p|
      next unless File.exist?(p)
      content = File.read(p)
      patched = content.dup

      # StorageProvider lines (both storage(app:) and storage(app:url:))
      patched.gsub!(/(ComponentType<StorageProvider>\.instance\(for:\s*StorageProvider\.self,\s*in:\s*app\.container\))(?!\s*!)/m, '\\1!')

      # Initializer assignments for AuthInterop and AppCheckInterop
      patched.gsub!(/(ComponentType<AuthInterop>\.instance\(for:\s*AuthInterop\.self,\s*in:\s*app\.container\))(?!\s*!)/m, '\\1!')
      patched.gsub!(/(ComponentType<AppCheckInterop>\.instance\(for:\s*AppCheckInterop\.self,\s*in:\s*app\.container\))(?!\s*!)/m, '\\1!')

      # Fallback: if provider is still optional, force unwrap at use sites
      patched.gsub!(/return\s+provider\.storage\(/, 'return provider!.storage(')

      # Fallback: ensure assignment lines unwrap the instance results
      patched.gsub!(/(auth\s*=\s*ComponentType<AuthInterop>\.instance\([^\)]*\))(?!\s*!)/m, '\\1!')
      patched.gsub!(/(appCheck\s*=\s*ComponentType<AppCheckInterop>\.instance\([^\)]*\))(?!\s*!)/m, '\\1!')

      if patched != content
        File.write(p, patched)
        puts "Patched FirebaseStorage optional providers in #{p}"
      else
        puts "FirebaseStorage already patched or pattern not found at #{p}"
      end
    end
  rescue => e
    puts "Warning: failed to patch FirebaseStorage Storage.swift: #{e}"
  end

  # --- Strip invalid PrivacyInfo.xcprivacy from flutter_app_badger_plus ---
  #
  # flutter_app_badger_plus 1.0.1 ships an invalid privacy manifest:
  #   <key>NSPrivacyAccessedAPITypes</key><array><dict/></array>
  #   <key>NSPrivacyCollectedDataTypes</key><array><dict/></array>
  # Empty <dict/> entries in these arrays violate Apple's schema (each
  # dict must declare a NSPrivacyAccessedAPIType / NSPrivacyCollected
  # DataType key). App Store Connect rejects the IPA with ITMS-91056.
  # Confirmed on builds 3.0.3+44 and 3.0.3+45.
  #
  # The plugin only sets a UIApplication notification badge \u2014 it does
  # not collect any of the data its manifest declares (and badge-setting
  # is not in Apple's required-reasons list, so no manifest is required
  # for this plugin at all). Safe fix: delete the file before Xcode
  # archives the resource bundle. Apple accepts an absent manifest for
  # plugins that don't use required-reasons APIs.
  #
  # IMPORTANT: the podspec declares
  #   s.resource_bundles = {'flutter_app_badger_plus_privacy' => ['PrivacyInfo.xcprivacy']}
  # with the source file at the plugin's ios/ root. CocoaPods does NOT
  # copy this into ios/Pods/flutter_app_badger_plus/; it references the
  # symlinked source at ios/.symlinks/plugins/flutter_app_badger_plus/
  # ios/PrivacyInfo.xcprivacy directly at Xcode build time. The earlier
  # glob `Pods/**/flutter_app_badger_plus*/**/PrivacyInfo.xcprivacy`
  # matched zero files in CI and the build sailed through to Apple.
  #
  # We now strip from BOTH:
  #   1. ios/.symlinks/plugins/flutter_app_badger_plus*/ios/PrivacyInfo.xcprivacy
  #      (the symlink Xcode actually reads)
  #   2. ~/.pub-cache/hosted/pub.dev/flutter_app_badger_plus-*/ios/PrivacyInfo.xcprivacy
  #      (the upstream the symlink points to; CodeMagic re-runs flutter
  #      pub get on every build, so deleting only the symlink target
  #      means the next pub get rehydrates the broken file)
  #
  # And RAISE if zero files matched. The silent fallback is exactly
  # what let builds 44 and 45 ship broken to Apple (45 min round-trip
  # per failed upload). If a future flutter_app_badger_plus version
  # moves or removes this file, we fail loudly at pod install instead
  # of after another 45-min Apple rejection cycle.
  begin
    candidate_globs = [
      File.expand_path('../.symlinks/plugins/flutter_app_badger_plus*/ios/PrivacyInfo.xcprivacy', __dir__),
      File.expand_path('~/.pub-cache/hosted/pub.dev/flutter_app_badger_plus-*/ios/PrivacyInfo.xcprivacy'),
    ]
    bad_manifests = candidate_globs.flat_map { |g| Dir.glob(g) }.uniq
    if bad_manifests.empty?
      raise "Expected to find flutter_app_badger_plus PrivacyInfo.xcprivacy at one of:\n  - #{candidate_globs.join("\n  - ")}\nbut found none. The plugin layout may have changed; update the globs in ios/Podfile and re-verify against the IPA assertion step in codemagic.yaml."
    end
    bad_manifests.each do |m|
      File.delete(m)
      puts "Removed invalid privacy manifest: #{m}"
    end
  end
  # --- END strip ---

  # --- NEW: Remove '-GCC_WARN_INHIBIT_ALL_WARNINGS' from BoringSSL-GRPC compile flags ---
  begin
    installer.pods_project.targets.each do |target|
      next unless target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end
    puts "Cleaned compiler flags for BoringSSL-GRPC"
  rescue => e
    puts "Warning: failed to adjust BoringSSL-GRPC compiler flags: #{e}"
  end
  # --- END NEW ---

end
