{
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "pubsub": {
      "port": 8085
    },
    "storage": {
      "port": 9199
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "/usr/bin/env -i PATH=/usr/bin:/bin /opt/homebrew/bin/node \"$PROJECT_DIR/functions/scripts/block-raw-production-functions-deploy.mjs\"",
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "predeploy": [
      "/usr/bin/env -i PATH=/usr/bin:/bin /opt/homebrew/bin/node \"$PROJECT_DIR/functions/scripts/block-raw-production-functions-deploy.mjs\""
    ],
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "predeploy": [
      "/usr/bin/env -i PATH=/usr/bin:/bin /opt/homebrew/bin/node \"$PROJECT_DIR/functions/scripts/block-raw-production-functions-deploy.mjs\""
    ],
    "rules": "storage.rules"
  }
}
