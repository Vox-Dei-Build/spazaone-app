# Copy this file to .env.local (and/or .env) and fill in the values.
# NEVER commit a populated .env file — see .gitignore.
# Source of truth for production is GCP Secret Manager / Firebase Functions
# config; this file documents the expected keys for local development.

# --- Immutable environment identity ---
# local | development | production. Deployed Functions fail closed when this
# does not match their explicit Firebase project ID.
SPAZAONE_ENVIRONMENT=local
SPAZAONE_FIREBASE_PROJECT_ID=demo-spazaone
BUILD_COMMIT=local

# --- Twilio ---
TWILIO_PROVIDER_MODE=disabled
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=
TWILIO_MERCHANT_MESSAGING_SERVICE_SID=
TWILIO_CUSTOMER_MESSAGING_SERVICE_SID=
# Approved Twilio Content SID for the payment-request quick-reply template.
# Its button payload must be `payment request {{requestId}}`.
TWILIO_PAYMENT_REQUEST_CONTENT_SID=
# Emulator-only aliases (kept for backwards compatibility):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_ID=

# --- WhatsApp / Meta ---
BOTPRESS_PROVIDER_MODE=disabled
CUSTOMER_PAYMENT_REQUESTS_ENABLED=false
BOTPRESS_PAYMENT_REQUEST_WEBHOOK_URL=
BOTPRESS_PAYMENT_REQUEST_TEMPLATE_NAME=
BOTPRESS_PAYMENT_REQUEST_TEMPLATE_LANGUAGE=en
BOTPRESS_PAYMENT_CONFIRMATION_TEMPLATE_NAME=
BOTPRESS_PAYMENT_CONFIRMATION_TEMPLATE_LANGUAGE=en
WHATSAPP_SENDER_NUMBER_ID=
# Shared only between the Spaza One bot and trusted Cloud Functions. Production
# value belongs in Secret Manager and the Botpress secret store.
PASELLA_BOT_TOKEN=
# Optional comma-separated HTTPS host suffixes for Botpress-downloaded media.
# Defaults fail closed to Botpress/BP Content domains.
BOTPRESS_MEDIA_HOSTS=

# --- Paystack ---
# disabled | stub | test | live. Development requires test; production accepts
# only disabled or live and validates the corresponding key prefix.
PAYSTACK_PROVIDER_MODE=disabled
# Fail closed until Spaza One has completed payment-provider compliance and
# explicitly approved digital-payment activation. Catalogue browsing, listing,
# buyer order requests and seller-confirmed manual payments remain available.
COMMERCE_PAYMENTS_ENABLED=false
# Failure-first V2 master switch. Production remains false until the final
# evidence pack and action-time activation approval exist.
PAYMENTS_V2_MASTER_ENABLED=false
# Configure a Paystack key only after approval. Use test credentials locally;
# live credentials belong in Secret Manager, never in this file.
PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
CJ_API_KEY=
# CJ operations default to the provider sandbox. Live purchase authority is a
# separate, explicit server-side switch even after supplier payments are on.
CJ_SANDBOX_MODE=true
CJ_LIVE_FULFILMENT_ENABLED=false
# Optional landed-cost FX reserve. 300 = 3% above the reference USD/ZAR rate.
CJ_FX_BUFFER_BPS=300

# --- Merchant activation push nudges ---
# Defaults in code are deliberately safe: disabled and dry-run.
ACTIVATION_NUDGES_ENABLED=false
ACTIVATION_NUDGES_DRY_RUN=true
# all | opt_in | prerelease
ACTIVATION_NUDGES_AUDIENCE=opt_in
ACTIVATION_NUDGES_MIN_BUILD=0
ACTIVATION_NUDGES_MAX_PER_RUN=500
ACTIVATION_NUDGES_MAX_PER_WEEK=3
