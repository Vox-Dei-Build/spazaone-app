# Copy this file to .env.local (and/or .env) and fill in the values.
# NEVER commit a populated .env file — see .gitignore.
# Source of truth for production is GCP Secret Manager / Firebase Functions
# config; this file documents the expected keys for local development.

# --- Twilio ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=
TWILIO_MERCHANT_MESSAGING_SERVICE_SID=
TWILIO_CUSTOMER_MESSAGING_SERVICE_SID=
# Emulator-only aliases (kept for backwards compatibility):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_ID=

# --- Email (Mailgun API) ---
EMAIL_ADMINLOGIN=
EMAIL_ADMINPASS=

# --- WhatsApp / Meta ---
WHATSAPP_SENDER_NUMBER_ID=
# Shared only between the Spaza One bot and trusted Cloud Functions. Production
# value belongs in Secret Manager and the Botpress secret store.
PASELLA_BOT_TOKEN=

# --- Paystack ---
# Fail closed until Spaza One has completed payment-provider compliance and
# explicitly approved digital-payment activation. Catalogue browsing, listing,
# buyer order requests and seller-confirmed manual payments remain available.
COMMERCE_PAYMENTS_ENABLED=false
# Configure a Paystack key only after approval. Use test credentials locally;
# live credentials belong in Secret Manager, never in this file.
PAYSTACK_SECRET_KEY=
CJ_API_KEY=
# Optional landed-cost FX reserve. 300 = 3% above the reference USD/ZAR rate.
CJ_FX_BUFFER_BPS=300

# --- Merchant activation push nudges ---
# Defaults in code are deliberately safe: disabled and dry-run.
ACTIVATION_NUDGES_ENABLED=false
ACTIVATION_NUDGES_DRY_RUN=true
# all | opt_in | prerelease
ACTIVATION_NUDGES_AUDIENCE=opt_in
ACTIVATION_NUDGES_MIN_BUILD=0
ACTIVATION_NUDGES_MAX_PER_RUN=500
ACTIVATION_NUDGES_MAX_PER_WEEK=3
