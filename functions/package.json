{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "npm run lint -- --fix",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test:urgent-update": "npm run build && node --test test/urgent_update_nudge_policy.test.mjs",
    "test:rules": "node --test test/multistore_rules.test.mjs",
    "test:security": "npm run build && node --test test/paystack_security.test.mjs test/bot_store_selection.test.mjs test/request_auth.test.mjs",
    "test:commerce": "npm run build && node --test test/commerce_domain.test.mjs test/cj_client.test.mjs",
    "test:commerce-integration": "npm run build && node --test --test-concurrency=1 test/commerce_payment.integration.test.mjs",
    "test:bot-http": "node --test --test-concurrency=1 test/bot_http.integration.test.mjs",
    "test:stores": "npm run build && node --test --test-concurrency=1 test/store_management.integration.test.mjs test/shared_campaign_credits.integration.test.mjs test/paystack_shared_credits.integration.test.cjs",
    "test:migration": "node --test --test-concurrency=1 test/migration.integration.test.mjs test/shared_credits_migration.integration.test.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "serve-debug": "npm run build && firebase emulators:start --only functions --debug",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "multistore:migrate": "node scripts/migrate-multistore.mjs",
    "shared-credits:migrate": "node scripts/migrate-shared-campaign-credits.mjs",
    "multistore:smoke-rules": "node scripts/smoke-production-rules.mjs"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "1.18.1",
    "currency-formatter": "^1.5.9",
    "dotenv": "^16.6.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "moment": "^2.30.1",
    "nodemailer": "^9.0.3",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/currency-formatter": "^1.5.4",
    "@types/node": "^22.5.1",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^5.0.0",
    "firebase": "^10.14.1",
    "firebase-functions-test": "^3.5.0",
    "prettier": "^3.0.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "express": "4.22.2",
    "path-to-regexp": "0.1.13",
    "websocket-driver": "0.7.5"
  },
  "private": true
}
