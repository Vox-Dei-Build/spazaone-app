{
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "host": "127.0.0.1",
      "port": 19099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 15001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 14000
    },
    "pubsub": {
      "host": "127.0.0.1",
      "port": 18085
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 19199
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "/usr/bin/env -i PATH=/usr/bin:/bin /opt/homebrew/bin/node \"$PROJECT_DIR/functions/scripts/block-raw-production-functions-deploy.mjs\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "predeploy": [
      "/usr/bin/env -i PATH=/usr/bin:/bin /opt/homebrew/bin/node \"$PROJECT_DIR/functions/scripts/block-raw-production-functions-deploy.mjs\""
    ],
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "predeploy": [
      "/usr/bin/env -i PATH=/usr/bin:/bin /opt/homebrew/bin/node \"$PROJECT_DIR/functions/scripts/block-raw-production-functions-deploy.mjs\""
    ],
    "rules": "storage.rules"
  },
  "remoteconfig": {
    "predeploy": [
      "/usr/bin/env -i PATH=/usr/bin:/bin /opt/homebrew/bin/node \"$PROJECT_DIR/functions/scripts/block-raw-production-functions-deploy.mjs\""
    ],
    "template": "remoteconfig.development.template.json"
  }
}
