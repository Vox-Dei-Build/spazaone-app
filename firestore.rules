rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSpazaAdmin() {
      return signedIn() && request.auth.token.spazaAdmin == true;
    }

    function isStoreMember(storeId) {
      return signedIn() && (
        request.auth.uid == storeId ||
        (
          exists(/databases/$(database)/documents/stores/$(storeId)/operators/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/stores/$(storeId)/operators/$(request.auth.uid)).data.status == 'active'
        )
      );
    }

    function isStoreManager(storeId) {
      return isStoreMember(storeId) && (
        request.auth.uid == storeId ||
        get(/databases/$(database)/documents/stores/$(storeId)/operators/$(request.auth.uid)).data.role in ['owner', 'admin']
      );
    }

    function hasCampaignWalletAccess(walletStoreId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/campaignWalletAccess/$(walletStoreId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/campaignWalletAccess/$(walletStoreId)/members/$(request.auth.uid)).data.storeIds is list &&
        get(/databases/$(database)/documents/campaignWalletAccess/$(walletStoreId)/members/$(request.auth.uid)).data.storeIds.size() > 0;
    }

    function ownsExisting(data) {
      return data.userId is string && isStoreMember(data.userId);
    }

    function ownsIncoming(data) {
      return data.userId is string && isStoreMember(data.userId);
    }

    function merchantOwnsExisting(data) {
      return data.merchantId is string && isStoreMember(data.merchantId);
    }

    function merchantOwnsIncoming(data) {
      return data.merchantId is string && isStoreMember(data.merchantId);
    }

    // Root merchant profiles remain readable during the legacy phone-login
    // transition. Customer, ledger, product and wallet subcollections are
    // tenant-scoped immediately. Remove the public root read after all
    // supported app versions use the App-Check-protected lookup endpoint.
    match /users/{storeId} {
      allow read: if true;
      allow create, update, delete: if isStoreMember(storeId);

      // Settlement destinations are more sensitive than ordinary store data.
      // Operators may see the masked app projection but cannot alter the raw
      // legacy record that an owner/admin later submits for verification.
      match /bankingDetails/{bankingDetailsId} {
        allow read: if isStoreMember(storeId);
        allow create, update, delete: if isStoreManager(storeId);
      }

      match /{collection}/{document=**} {
        allow read, write: if collection != 'bankingDetails' &&
          isStoreMember(storeId);
      }
    }

    // Build 4.3.1+74 uses a collection-group query for overdue transactions
    // without a tenant field in the query. Keep authenticated reads working
    // during the upgrade window so deploying these rules cannot break the
    // released reporting screen. Build 4.4 scopes this report beneath the
    // selected store; remove this compatibility match once 4.3 is outside the
    // supported-version window. Writes remain governed by the store-scoped
    // /users/{storeId}/... rule above.
    match /{path=**}/transactions/{transactionId} {
      allow read: if signedIn();
    }

    match /stores/{storeId} {
      allow read: if isStoreMember(storeId);
      allow write: if false; // Cloud Functions Admin SDK only.

      match /operators/{uid} {
        allow read: if isStoreMember(storeId);
        allow create, delete: if false;
        allow update: if signedIn() &&
          request.auth.uid == uid &&
          resource.data.status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fcmToken', 'fcmTokens', 'notificationUpdatedAt']);
      }
    }

    match /operators/{uid}/stores/{storeId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Shared-store operators see only the campaign-credit projection. They
    // never receive access to the canonical wallet document, which also holds
    // primary-store sales, payout, and cash-advance fields.
    match /campaignWalletBalances/{walletStoreId} {
      allow read: if isStoreMember(walletStoreId) ||
        hasCampaignWalletAccess(walletStoreId);
      allow write: if false;
    }

    match /campaignWalletAccess/{walletStoreId}/{document=**} {
      allow read, write: if false;
    }

    match /notifications/{storeId}/{document=**} {
      allow read, write: if isStoreMember(storeId);
    }

    match /operatorInvites/{phoneHash}/{document=**} {
      allow read, write: if false;
    }

    match /operatorPhoneLookup/{phoneHash}/{document=**} {
      allow read, write: if false;
    }

    match /messagingTemplates/{templateId} {
      allow read: if signedIn() && (
        resource.data.systemManaged == true || ownsExisting(resource.data)
      );
      allow create: if signedIn() && ownsIncoming(request.resource.data);
      allow update: if signedIn() &&
        ownsExisting(resource.data) &&
        ownsIncoming(request.resource.data);
      allow delete: if signedIn() && ownsExisting(resource.data);
    }

    match /promotions/{promotionId} {
      allow read, delete: if signedIn() && merchantOwnsExisting(resource.data);
      allow create: if signedIn() && merchantOwnsIncoming(request.resource.data);
      allow update: if signedIn() &&
        merchantOwnsExisting(resource.data) &&
        merchantOwnsIncoming(request.resource.data);
    }

    match /payoutRequests/{requestId} {
      allow read, delete: if signedIn() && merchantOwnsExisting(resource.data);
      allow create: if signedIn() && merchantOwnsIncoming(request.resource.data);
      allow update: if signedIn() &&
        merchantOwnsExisting(resource.data) &&
        merchantOwnsIncoming(request.resource.data);
    }

    match /paymentReferences/{referenceId} {
      allow read, delete: if signedIn() && merchantOwnsExisting(resource.data);
      allow create: if signedIn() && merchantOwnsIncoming(request.resource.data);
      allow update: if signedIn() &&
        merchantOwnsExisting(resource.data) &&
        merchantOwnsIncoming(request.resource.data);
    }

    // Failure-first Payments V2 is an Admin SDK-only trust boundary. Released
    // clients still use legacy user-tree records, but no client (including a
    // store owner or spazaAdmin claim) may read or forge provider proof,
    // settlement instructions, reconciliation evidence or payment state.
    // Purpose-limited projections are returned through authenticated
    // Functions instead.
    match /paymentIntents/{document=**} {
      allow read, write: if false;
    }

    match /paymentEvents/{document=**} {
      allow read, write: if false;
    }

    match /merchantPaymentProfiles/{document=**} {
      allow read, write: if false;
    }

    match /settlements/{document=**} {
      allow read, write: if false;
    }

    match /refundCases/{document=**} {
      allow read, write: if false;
    }

    match /inventoryReservations/{document=**} {
      allow read, write: if false;
    }

    match /supplierFulfilments/{document=**} {
      allow read, write: if false;
    }

    match /supplierFundingReservations/{document=**} {
      allow read, write: if false;
    }

    match /supplierFundingState/{document=**} {
      allow read, write: if false;
    }

    match /operationsAlerts/{document=**} {
      allow read, write: if false;
    }

    match /supplierCancellationRequests/{document=**} {
      allow read, write: if false;
    }

    match /paymentOperations/{document=**} {
      allow read, write: if false;
    }

    match /customerPaymentRequests/{document=**} {
      allow read, write: if false;
    }

    match /customerPaymentRequestState/{document=**} {
      allow read, write: if false;
    }

    match /paymentRequestWalletReservations/{document=**} {
      allow read, write: if false;
    }

    match /financialReconciliationRuns/{document=**} {
      allow read, write: if false;
    }

    match /financialMigrationRuns/{document=**} {
      allow read, write: if false;
    }

    match /schemaMetadata/{document=**} {
      allow read, write: if false;
    }

    match /developmentSeedRuns/{document=**} {
      allow read, write: if false;
    }

    match /paymentConfiguration/{document=**} {
      allow read, write: if false;
    }

    match /paymentSecurityBudgets/{document=**} {
      allow read, write: if false;
    }

    match /paymentAdministrationAudit/{document=**} {
      allow read, write: if false;
    }

    match /paymentAdminReviewEmailOutbox/{document=**} {
      allow read, write: if false;
    }

    match /merchantCommerceSettings/{document=**} {
      allow read, write: if false;
    }

    match /campaignCreditPurchases/{document=**} {
      allow read, write: if false;
    }

    match /campaignCreditRecoveryCases/{document=**} {
      allow read, write: if false;
    }

    match /repaymentPlans/{document=**} {
      allow read, write: if false;
    }

    match /commerceNotificationOutbox/{document=**} {
      allow read, write: if false;
    }

    // Canonical checkout listings cannot be edited from a client. Sellers use
    // their compatible users/{storeId}/products projection in the app.
    match /commerceListings/{listingId} {
      allow read: if isSpazaAdmin() ||
        (resource.data.sellerId is string &&
          isStoreMember(resource.data.sellerId));
      allow write: if false;
    }

    // commerceOrders, not manual Sales, are the dropshipping source of truth.
    // All mutations pass through guarded Cloud Functions so price snapshots,
    // status transitions and audit history cannot be forged by a client.
    match /commerceOrders/{orderId} {
      allow read: if isSpazaAdmin() ||
        (resource.data.sellerId is string &&
          isStoreMember(resource.data.sellerId));
      allow write: if false;
    }

    // The automatically materialised supplier catalogue, refresh jobs, demand
    // aggregates and global provider gate are server-owned. Sellers access the
    // catalogue only through authenticated callables so supplier snapshots and
    // queue priority cannot be forged from a client.
    match /supplierCatalogProducts/{document=**} {
      allow read, write: if false;
    }

    match /supplierCatalogJobs/{document=**} {
      allow read, write: if false;
    }

    match /supplierCatalogDemand/{document=**} {
      allow read, write: if false;
    }

    match /supplierIntegrationState/{document=**} {
      allow read, write: if false;
    }

    // Capability cache contains phone-number delivery capability but no
    // customer ledger data. Keep authenticated compatibility until it moves
    // behind a callable; unauthenticated access is denied.
    match /successfulWhatsAppNumbers/{numberId} {
      allow read, write: if signedIn();
    }

    // All remaining top-level operational collections are server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
